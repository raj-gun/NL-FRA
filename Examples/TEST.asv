%%
%% Local Functions
%%
%%
%% ODE func

% function dy=ODE_func(t,Y,f1,f2,Amp)
% %%
% PE = Amp.*(3/(2*pi)).*(sin(2.*f1.*pi.*t)-sin(2.*f2.*pi.*t))./t;%Amp.*( 0.6 + 0.1*cos(2.*f1.*pi.*t));% + Amp.*(sin(2.*f2.*pi.*t));% + Amp.*(sin(2.*3*f1.*pi.*t)); Amp.*cos(2.*f1.*pi.*t);%
% PI = 0;%Amp.*( 0.6 + 0.1*cos(2.*f1.*pi.*t));
% %%
% tau_e = 0.0035; tau_i = 0.0052; 
% T_EE = 2.4; T_EI = 2; T_IE = 2.1; T_II = 0;
% r =4; S_0 = 1; v_0 = 1;
% 
% 
% x1 = PE + T_EE*Y(1) - T_IE*Y(2);
% x2 = PI + T_EE*Y(1) - T_II*Y(2);
% 
% dy = [(-1/tau_e)*Y(1) + (1/tau_e)*( S_0 / ( 1 + exp(-r*(x1-v_0)) ) );...
%       (-1/tau_i)*Y(2) + (1/tau_i)*( S_0 / ( 1 + exp(-r*(x2-v_0)) ) )];
% 
% 
% end


function dy=ODE_func(t,Y,f1,f2,Amp)

%%
u = Amp.*(3/(2*pi)).*(sin(2.*f1.*pi.*t)-sin(2.*f2.*pi.*t))./t;

%%
M = 0.013;
C = 0.0607;
K1 = 40;
K3 = -2.1e5;
K5 = 4.21e9;

%%
dy = [Y(2);...
      (1/M)*(u - C*Y(2) - K1*Y(1) - K3*Y(1)^3 - K5*Y(1)^5)];

end

function [y,Fs_new] = FIR_downsample(x,Fs,M)

%% New sampling frequency
Fs_new = Fs/M;

%% Low-pass filter frequencies
Fstop = Fs_new/2;       % New Nyquist frequency
Fpass = 0.8*Fstop;      % Passband edge

%% Filter specifications
Rp = 0.01;              % Passband deviation
Rs = 60;                % Stopband attenuation (dB)

dev = [Rp 10^(-Rs/20)];

%% Automatically determine FIR filter order
[N,Wn,beta,ftype] = kaiserord([Fpass Fstop], ...
                              [1 0],dev,Fs);

%% Design FIR filter
b = fir1(N,Wn,ftype,kaiser(N+1,beta),'noscale');

%% Apply low-pass filter
x_filt = filtfilt(b,1,x);

%% Downsample
y = x_filt(1:M:end,:);

end